{
  "spec_version": "v0",
  "note": "Cross-sector question bank with hand-authored gold IR. Sectors are civic/economic only: health, education, retail, economy, civic. Question-types: STATE, RELATION, CHANGE, TREND, VALUE, TRANSFER, AMBIGUOUS (must produce holes), BEHAVIOUR (proxy + data_request). gold_shape lists the ops the tree must contain; gold_shapes (optional) is an allow-set of acceptable shapes; expect is the executor outcome class.",
  "questions": [
    {"id":"health-01","sector":"health","type":"STATE","q":"How many clinics are there in Kisumu, Kenya?",
     "gold_shape":["AGGREGATE","SELECT"],"expect":"answer",
     "gold_ir":{"op":"AGGREGATE","by":"space","metric":"count","source":{"op":"SELECT","entity":"clinic","region":{"op":"REGION","place":"Kisumu, Kenya"},"time":null}}},
    {"id":"health-02","sector":"health","type":"RELATION","q":"Which pharmacies in Nairobi are within a kilometer of a hospital?",
     "gold_shape":["RELATE","SELECT","SELECT"],"expect":"answer",
     "gold_ir":{"op":"RELATE","relation":"within","left":{"op":"SELECT","entity":"pharmacy","region":{"op":"REGION","place":"Nairobi, Kenya"},"time":null},"right":{"op":"SELECT","entity":"hospital","region":{"op":"REGION","place":"Nairobi, Kenya"},"time":null}}},
    {"id":"health-03","sector":"health","type":"TREND","q":"Is health expenditure rising in Bangladesh?",
     "gold_shape":["COMPARE","AGGREGATE","SELECT"],"expect":"answer",
     "gold_ir":{"op":"COMPARE","how":"trend_direction","left":{"op":"AGGREGATE","by":"time","metric":"mean","source":{"op":"SELECT","entity":"health expenditure","region":{"op":"REGION","place":"Bangladesh"},"time":{"start":"2000","end":"2022"}}}}},
    {"id":"health-04","sector":"health","type":"AMBIGUOUS","q":"Tell me about the health facilities here.",
     "gold_shape":["SELECT"],"expect":"data_request","must_hole":true,
     "gold_ir":{"op":"SELECT","entity":"?facility_type","region":"?place","time":null}},
    {"id":"health-05","sector":"health","type":"TRANSFER","q":"We have no pharmacy data for Kisii town — estimate pharmacy access there from nearby Kisumu.",
     "gold_shape":["ESTIMATE","SELECT"],"expect":"answer_or_data_request","must_estimate":true,
     "gold_ir":{"op":"ESTIMATE","method":"envelope","target":{"op":"REGION","place":"Kisii, Kenya"},"source":{"op":"SELECT","entity":"pharmacy","region":{"op":"REGION","place":"Kisumu, Kenya"},"time":null}}},

    {"id":"edu-01","sector":"education","type":"STATE","q":"How many schools are in Kisumu, Kenya?",
     "gold_shape":["AGGREGATE","SELECT"],"expect":"answer",
     "gold_ir":{"op":"AGGREGATE","by":"space","metric":"count","source":{"op":"SELECT","entity":"school","region":{"op":"REGION","place":"Kisumu, Kenya"},"time":null}}},
    {"id":"edu-02","sector":"education","type":"RELATION","q":"Which schools in Nairobi are within a kilometer of a library?",
     "gold_shape":["RELATE","SELECT","SELECT"],"expect":"answer",
     "gold_ir":{"op":"RELATE","relation":"within","left":{"op":"SELECT","entity":"school","region":{"op":"REGION","place":"Nairobi, Kenya"},"time":null},"right":{"op":"SELECT","entity":"library","region":{"op":"REGION","place":"Nairobi, Kenya"},"time":null}}},
    {"id":"edu-03","sector":"education","type":"TREND","q":"Is secondary school enrollment rising in Vietnam?",
     "gold_shape":["COMPARE","AGGREGATE","SELECT"],"expect":"answer",
     "gold_ir":{"op":"COMPARE","how":"trend_direction","left":{"op":"AGGREGATE","by":"time","metric":"mean","source":{"op":"SELECT","entity":"secondary enrollment","region":{"op":"REGION","place":"Vietnam"},"time":{"start":"2000","end":"2022"}}}}},
    {"id":"edu-04","sector":"education","type":"AMBIGUOUS","q":"Map the education facilities around here.",
     "gold_shape":["SELECT"],"expect":"data_request","must_hole":true,
     "gold_ir":{"op":"SELECT","entity":"?facility_type","region":"?place","time":null}},

    {"id":"econ-01","sector":"economy","type":"TREND","q":"Is GDP per capita rising in Vietnam?",
     "gold_shape":["COMPARE","AGGREGATE","SELECT"],"expect":"answer",
     "gold_ir":{"op":"COMPARE","how":"trend_direction","left":{"op":"AGGREGATE","by":"time","metric":"mean","source":{"op":"SELECT","entity":"gdp per capita","region":{"op":"REGION","place":"Vietnam"},"time":{"start":"2000","end":"2023"}}}}},
    {"id":"econ-02","sector":"economy","type":"CHANGE","q":"How much did internet use in Kenya change between 2010 and 2020?",
     "gold_shape":["COMPARE","SELECT"],"gold_shapes":[["COMPARE","SELECT","SELECT"],["COMPARE","AGGREGATE","SELECT","AGGREGATE","SELECT"]],"expect":"answer",
     "gold_ir":{"op":"COMPARE","how":"difference","left":{"op":"SELECT","entity":"internet users","region":{"op":"REGION","place":"Kenya"},"time":{"start":"2020","end":"2020"}},"right":{"op":"SELECT","entity":"internet users","region":{"op":"REGION","place":"Kenya"},"time":{"start":"2010","end":"2010"}}}},
    {"id":"econ-03","sector":"economy","type":"RELATION","q":"How does GDP per capita in Kenya compare with Uganda?",
     "gold_shape":["COMPARE","SELECT","SELECT"],"gold_shapes":[["COMPARE","SELECT","SELECT"],["COMPARE","AGGREGATE","SELECT","AGGREGATE","SELECT"]],"expect":"answer",
     "gold_ir":{"op":"COMPARE","how":"difference","left":{"op":"SELECT","entity":"gdp per capita","region":{"op":"REGION","place":"Kenya"},"time":{"start":"2022","end":"2022"}},"right":{"op":"SELECT","entity":"gdp per capita","region":{"op":"REGION","place":"Uganda"},"time":{"start":"2022","end":"2022"}}}},
    {"id":"econ-04","sector":"economy","type":"BEHAVIOUR","q":"Why are young people in this district leaving for the city?",
