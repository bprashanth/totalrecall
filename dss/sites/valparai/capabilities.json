{
  "schema_version": "visual-capability-registry/0.1",
  "capabilities": [
    {
      "capability_id": "site-orientation",
      "version": "1.0.0",
      "label": "Orient to the site and indexed evidence",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_views": ["site-orientation"],
      "required_planes": ["aoi", "events", "cells", "source_coverage"],
      "optional_planes": ["locations", "effort", "measurements"],
      "latency_class": "interactive",
      "evidence_classes": ["reported", "derived"],
      "availability": "ready"
    },
    {
      "capability_id": "entity-record-map",
      "version": "1.0.0",
      "label": "Map source-linked records for a resolved entity",
      "input_schema": {
        "type": "object",
        "required": ["entity"],
        "properties": {
          "entity": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": ["observed-points", "surrounding-data"],
      "required_planes": ["entity_aliases", "events", "cells"],
      "optional_planes": ["effort"],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "coverage-versus-effort",
      "version": "1.0.0",
      "label": "Compare record coverage with explicit survey effort",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_views": ["coverage-and-effort"],
      "required_planes": ["events", "effort", "cells"],
      "optional_planes": [],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "derived"],
      "availability": "ready"
    },
    {
      "capability_id": "group-record-map",
      "version": "1.0.0",
      "label": "Map source-linked records for a canonical hierarchy group",
      "input_schema": {
        "type": "object",
        "required": ["rank", "group"],
        "properties": {
          "rank": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "group": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": ["group-observed-points"],
      "required_planes": ["entity_hierarchy", "events", "cells"],
      "optional_planes": ["effort"],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "metric-time-series",
      "version": "1.0.0",
      "label": "Plot a unit-compatible metric with coverage",
      "input_schema": {
        "type": "object",
        "required": ["metric"],
        "properties": {
          "metric": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": ["metric-time-series"],
      "required_planes": ["measurements", "metric_units", "time_buckets"],
      "optional_planes": [],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "derived"],
      "availability": "ready"
    },
    {
      "capability_id": "interaction-map",
      "version": "1.0.0",
      "label": "Map and connect explicitly admitted subject-object associations",
      "input_schema": {
        "type": "object",
        "required": ["interaction_type"],
        "properties": {
          "interaction_type": {"type": "string", "minLength": 1},
          "entity": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": [
        "source-reported-interaction-map",
        "source-reported-interaction-network"
      ],
      "required_planes": ["interactions", "entity_aliases", "cells"],
      "optional_planes": ["events", "effort"],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "derived", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "gated-transfer",
      "version": "1.0.0",
      "label": "Screen environmental analogues from admitted donor records into a target",
      "input_schema": {
        "type": "object",
        "required": ["entity", "donor_scope", "target_scope"],
        "properties": {
          "entity": {"type": "string", "minLength": 1},
          "donor_scope": {"type": "string", "minLength": 1},
          "target_scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": ["donor-target-gates", "transfer-gates"],
      "required_planes": ["events", "cell_features", "cells"],
      "optional_planes": ["effort", "model_runs", "action_costs"],
      "latency_class": "model",
      "evidence_classes": ["observed", "modelled", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "stratified-survey-summary",
      "version": "1.0.0",
      "label": "Map surveyed sites and compare source-reported categories with effort",
      "input_schema": {
        "type": "object",
        "required": ["source_id", "category_property"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "category_property": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "event_type": {"type": "string", "minLength": 1},
          "effort_method": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": [
        "stratified-survey-sites",
        "stratified-category-comparison"
      ],
      "required_planes": ["events", "effort", "cells"],
      "optional_planes": ["measurements", "entity_aliases"],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "derived", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "cell-feature-map",
      "version": "1.0.0",
      "label": "Map a cell-aligned context or predictor feature with lineage",
      "input_schema": {
        "type": "object",
        "required": ["feature_id", "year"],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "year": {"type": "integer", "minimum": 1900, "maximum": 2200},
          "scope": {
            "type": "string",
            "enum": ["target", "context", "all_indexed"],
            "default": "context"
          }
        },
        "additionalProperties": false
      },
      "output_views": ["cell-feature-map", "cell-feature-metadata"],
      "required_planes": ["cell_features", "cells", "source_coverage"],
      "optional_planes": ["events", "measurements"],
      "latency_class": "interactive",
      "evidence_classes": ["derived", "modelled", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "plot-indicator-profile",
      "version": "1.0.0",
      "label": "Map a source-linked plot indicator and compare declared categories",
      "input_schema": {
        "type": "object",
        "required": ["metric"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "category_property": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "default": "comparison_class"
          }
        },
        "additionalProperties": false
      },
      "output_views": [
        "plot-indicator-map",
        "plot-indicator-category-summary"
      ],
      "required_planes": ["measurements", "metric_definitions", "locations"],
      "optional_planes": ["effort", "entity_hierarchy"],
      "latency_class": "interactive",
      "evidence_classes": ["observed", "derived", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "matrix-profile",
      "version": "1.0.0",
      "label": "Compare a source-linked matrix across declared categories and sites",
      "input_schema": {
        "type": "object",
        "required": ["source_id", "matrix_id"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "matrix_id": {"type": "string", "minLength": 1},
          "category_property": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "default": "comparison_class"
          }
        },
        "additionalProperties": false
      },
      "output_views": ["matrix-profile", "matrix-series-sites"],
      "required_planes": ["matrix_values", "locations", "source_coverage"],
      "optional_planes": ["measurements", "effort"],
      "latency_class": "interactive",
      "evidence_classes": ["derived", "missing"],
      "availability": "ready"
    },
    {
      "capability_id": "method-catalog",
      "version": "1.0.0",
      "label": "Inspect source-linked analysis methods, gates and claim limits",
      "input_schema": {
        "type": "object",
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "applies_to": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "output_views": ["method-catalog"],
      "required_planes": ["method_cards"],
      "optional_planes": ["measurements", "events", "effort", "cell_features"],
      "latency_class": "interactive",
      "evidence_classes": ["reported", "missing"],
      "availability": "ready"
    }
  ]
}
