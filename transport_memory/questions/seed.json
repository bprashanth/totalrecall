{
  "spec_version": "v2",
  "note": "transport sector seed bank — hand-written gold IRs, entities/cities verified by the 2026-07-12 data census (FINDINGS.md)",
  "questions": [
    {
      "id": "tr-state-01", "sector": "transport", "type": "STATE",
      "q": "How many bus stops are there in Rosario, Argentina?",
      "expect": "answer",
      "gold_ir": {"op": "AGGREGATE", "by": "space", "metric": "count",
                  "source": {"op": "SELECT", "entity": "bus stop",
                             "region": {"op": "REGION", "place": "Rosario, Argentina"}, "time": null}},
      "gold_shape": ["AGGREGATE", "SELECT"]
    },
    {
      "id": "tr-state-02", "sector": "transport", "type": "STATE",
      "q": "Where are the ferry terminals in Mombasa, Kenya?",
