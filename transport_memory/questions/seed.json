                            "region": {"op": "REGION", "place": "Vietnam"},
                            "time": {"start": "2010", "end": "2010"}}},
      "gold_shape": ["COMPARE", "SELECT", "SELECT"]
    },
    {
      "id": "tr-chg-02", "sector": "transport", "type": "CHANGE",
