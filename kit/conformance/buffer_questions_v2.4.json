                            "source": {"op": "REGION", "place": "Pune, India"}}, "time": null},
        "right": {"op": "SELECT", "entity": "hospital",
                  "region": {"op": "BUFFER", "radius_km": 25.0,
                             "source": {"op": "REGION", "place": "Pune, India"}}, "time": null}
      }
    },
    {
