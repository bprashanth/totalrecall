      "expect": "answer",
      "gold_ir": {
        "op": "RELATE", "relation": "within", "threshold_km": 2.0,
        "left": {"op": "SELECT", "entity": "clinic",
                 "region": {"op": "BUFFER", "radius_km": 5.0,
                            "source": {"op": "REGION", "place": "Mysuru, India"}}, "time": null},
        "right": {"op": "SELECT", "entity": "school",
                  "region": {"op": "BUFFER", "radius_km": 15.0,
                             "source": {"op": "REGION", "place": "Mysuru, India"}}, "time": null}
      }
    },
    {
      "id": "buf-005",
      "q": "Start with a 5 km search around Surat, India, and expand that support by another 3 km for hospitals.",
