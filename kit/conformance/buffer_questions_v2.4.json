  "questions": [
    {
      "id": "buf-001",
      "q": "Search within 10 km around Erode town for clinics.",
      "expect": "answer",
      "gold_ir": {
        "op": "SELECT",
        "entity": "clinic",
        "region": {"op": "BUFFER", "radius_km": 10.0,
                   "source": {"op": "REGION", "place": "Erode town"}},
        "time": null
      }
    },
    {
      "id": "buf-002",
      "q": "Search 10 km around Erode town, then list clinics within 2 km of schools in that search extent.",
      "expect": "answer",
      "gold_ir": {
        "op": "RELATE", "relation": "within", "threshold_km": 2.0,
        "left": {"op": "SELECT", "entity": "clinic",
                 "region": {"op": "BUFFER", "radius_km": 10.0,
                            "source": {"op": "REGION", "place": "Erode town"}}, "time": null},
        "right": {"op": "SELECT", "entity": "school",
                  "region": {"op": "BUFFER", "radius_km": 10.0,
                             "source": {"op": "REGION", "place": "Erode town"}}, "time": null}
      }
    },
    {
      "id": "buf-003",
      "q": "Within a 25 km search around Pune, India, find pharmacies that have a hospital within 1 km.",
